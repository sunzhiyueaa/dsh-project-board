{
  "name": "@local/dsh-project-board",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 项目进度看板：原生侧边栏面板，五列按状态分，拖动改状态、单击进项目继续开发。",
  "license": "MIT",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  }
}
